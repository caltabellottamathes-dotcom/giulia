{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Giulia",
  "version": "0.1.0",
  "identifier": "com.giulia.os",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Giulia",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "resizable": true,
        "visible": true
      },
      {
        "label": "palette",
        "url": "/quick",
        "title": "Giulia Command",
        "width": 640,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": { "csp": null },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "tooltip": "Giulia",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}