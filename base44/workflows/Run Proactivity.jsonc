{
  "name": "Run Proactivity",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "run_proactivity",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "proactivity": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runProactivity"
          },
          "then": "end",
          "x-base44": {
            "title": "Proactiviteit draaien",
            "description": "Elke 30 min"
          }
        }
      }
    ]
  },
  "description": "Verzamelt alle agent-status elke 30 minuten en stuurt \u00e9\u00e9n proactief bericht + push als Salvo's aandacht nodig is.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Amsterdam",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}