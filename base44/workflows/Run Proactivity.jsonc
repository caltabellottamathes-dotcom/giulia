{
  "name": "Run Proactivity",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "run_proactivity",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "proactivity": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runProactivity"
          },
          "then": "end",
          "x-base44": {
            "title": "Living schedule check",
            "description": "Dagelijks 12:00 & 16:00"
          }
        }
      }
    ]
  },
  "description": "Living schedule: controleert elke dag om 12:00 en 16:00 of de focus-taken van vandaag nog lopen en verschuift laag-prioritaire taken om kern-deadlines te beschermen; scant op dead-end threads (>3 dagen wachten) en stelt follow-up approvals voor.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 12,16 * * *",
      "one_time_date": null,
      "timezone": "Europe/Amsterdam",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}