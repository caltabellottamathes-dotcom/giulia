{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 23 * * *",
      "one_time_date": null,
      "timezone": "Europe/Amsterdam",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Herbeoordeelt en consolideert het geheugen: verwijdert ruis en systeemstatus, voegt bijna-dubbele herinneringen samen tot rijkere samenvattingen.",
  "name": "Memory Consolidation",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "memory_consolidation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "consolidate_memories": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "consolidateMemories"
          },
          "then": "end",
          "x-base44": {
            "title": "Geheugen consolidatie",
            "description": "Ruis eruit, duplicaten samenvoegen"
          }
        }
      }
    ]
  }
}