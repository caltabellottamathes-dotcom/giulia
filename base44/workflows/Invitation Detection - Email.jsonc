{
  "name": "Invitation Detection - Email",
  "description": "\u00a719.6 \u2014 herkent uitnodigingen in binnenkomende emails.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Email",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.folder != \"sent\" and .trigger.data.contact_id != null }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "invitation_detection_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "detect": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "invitationDetection",
            "args": {
              "contact_id": "${ .trigger.data.contact_id }",
              "text": "${ .trigger.data.body }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Detect invitation",
            "description": "Uitnodiging \u2260 bevestigde afspraak"
          }
        }
      }
    ]
  }
}