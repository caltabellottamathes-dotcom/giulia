{
  "name": "WhatsApp Ingestion",
  "description": "Interpreteert elk nieuw inkomend WhatsApp-bericht (direction: received, status: unread) via interpretInput.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "WhatsAppMessage",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.direction == \"received\" and .trigger.data.status == \"unread\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "whatsapp_ingestion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "interpret": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "interpretInput",
            "args": {
              "source": "whatsapp",
              "message_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Interpreteer WhatsApp-bericht",
            "description": "NLP-extractie \u2192 Task/Approval/Insight/CalendarEvent"
          }
        }
      }
    ]
  }
}