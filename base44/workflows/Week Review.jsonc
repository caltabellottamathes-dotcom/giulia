{
  "name": "Week Review",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "week_review",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "review": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "weekReview"
          },
          "then": "end",
          "x-base44": {
            "title": "Week evaluatie",
            "description": "Vrijdag 17:00"
          }
        }
      }
    ]
  },
  "description": "Analyseert elke vrijdag 17:00 de week: voltooid, verschoven, open commitments, input voor nieuwe week.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 17 * * 5",
      "one_time_date": null,
      "timezone": "Europe/Amsterdam",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}