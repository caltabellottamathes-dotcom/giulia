{
  "name": "Self Overload Guard",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 12,16 * * *",
      "one_time_date": null,
      "timezone": "Europe/Amsterdam",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Proactieve SELF-bewaking: capacity/overload detectie + beschermde-tijd conflict-controle. Loopt op het runProactivity-ritme.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "self_overload_guard",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "detect_overload": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "detectSelfOverload"
          },
          "then": "end",
          "x-base44": {
            "title": "Overload-bewaking",
            "description": "Capacity + personal-time conflicten"
          }
        }
      }
    ]
  }
}