{
  "name": "Calendar Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "calendar_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncCalendar"
          },
          "then": "end",
          "x-base44": {
            "title": "Agenda synchroniseren",
            "description": "Elke 15 min"
          }
        }
      }
    ]
  },
  "description": "Synchroniseert Google Calendar naar de Event entity elke 15 minuten.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Amsterdam",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}