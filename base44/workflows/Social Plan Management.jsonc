{
  "name": "Social Plan Management",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "social_plan_management",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "manage": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "socialPlanManagement",
            "args": {
              "plan_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Manage social plan",
            "description": "Reconciliatie na create/update"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "SocialPlan"
    }
  },
  "description": "\u00a719 \u2014 reconcilieert een SocialPlan na create/update: Calendar-koppeling, Opportunity-afsluiting, protected-time-conflict."
}