{
  "name": "Manage People",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "manage_people",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "manage": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "managePeople"
          },
          "then": "end",
          "x-base44": {
            "title": "Personen beheren",
            "description": "Dagelijks 09:00"
          }
        }
      }
    ]
  },
  "description": "Herkent personen uit communicatie en werkt contacten bij dagelijks om 09:00.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "Europe/Amsterdam",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
