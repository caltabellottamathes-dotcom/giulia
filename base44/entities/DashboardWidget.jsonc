{
  "name": "DashboardWidget",
  "type": "object",
  "properties": {
    "widget_type": {
      "type": "string",
      "title": "Widget Type"
    },
    "position": {
      "type": "number",
      "default": 0,
      "title": "Position"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "title": "Visible"
    },
    "x": {
      "type": "number",
      "default": 0,
      "title": "X"
    },
    "y": {
      "type": "number",
      "default": 0,
      "title": "Y"
    }
  },
  "required": [
    "widget_type"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}