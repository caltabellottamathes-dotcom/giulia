{
  "name": "DashboardWidget",
  "type": "object",
  "properties": {
    "widget_type": {
      "type": "string",
      "title": "Widget Type"
    },
    "board_id": {
      "type": "string",
      "default": "giulia",
      "title": "Board ID"
    },
    "position": {
      "type": "number",
      "default": 0,
      "title": "Position"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "title": "Visible"
    },
    "theme": {
      "type": "string",
      "enum": [
        "glass",
        "solid"
      ],
      "default": "glass",
      "title": "Theme"
    },
    "color": {
      "type": "string",
      "enum": [
        "charcoal",
        "olive",
        "sand",
        "ridge",
        "storm"
      ],
      "default": "charcoal",
      "title": "Color"
    },
    "opacity": {
      "type": "number",
      "default": 1,
      "title": "Opacity"
    },
    "blur": {
      "type": "number",
      "default": 0,
      "title": "Blur"
    },
    "x": {
      "type": "number",
      "default": 0,
      "title": "X"
    },
    "y": {
      "type": "number",
      "default": 0,
      "title": "Y"
    }
  },
  "required": [
    "widget_type"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}