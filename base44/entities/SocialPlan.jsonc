{
  "name": "SocialPlan",
  "type": "object",
  "properties": {
    "contact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Contact IDs"
    },
    "activity": {
      "type": "string",
      "title": "Activity"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "confirmed",
        "done",
        "cancelled"
      ],
      "default": "planned",
      "title": "Status"
    },
    "calendar_event_id": {
      "type": "string",
      "title": "Calendar Event ID"
    },
    "suggested_date": {
      "type": "string",
      "format": "date-time",
      "title": "Suggested Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    },
    "personal_time_block_id": {
      "type": "string",
      "title": "Personal Time Block ID",
      "description": "Gekoppeld PersonalTimeBlock waaruit dit plan de ruimte innam."
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "whatsapp",
        "email",
        "opportunity",
        "intention"
      ],
      "default": "manual",
      "title": "Source"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Confirmed At"
    },
    "source_opportunity_id": {
      "type": "string",
      "title": "Source Opportunity ID"
    }
  },
  "required": [
    "activity"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}