{
  "name": "GiuliaDraft",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp",
        "calendar",
        "task"
      ],
      "title": "Type"
    },
    "source": {
      "type": "string",
      "title": "Source"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "context": {
      "type": "string",
      "title": "Context"
    },
    "status": {
      "type": "string",
      "enum": [
        "awaiting_approval",
        "approved",
        "rejected",
        "sent"
      ],
      "default": "awaiting_approval",
      "title": "Status"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "contact_id": {
      "type": "string",
      "title": "Contact ID"
    }
  },
  "required": [
    "type",
    "content"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}