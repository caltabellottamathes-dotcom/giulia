{
  "name": "AdminObligation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "type": {
      "type": "string",
      "enum": [
        "payment",
        "insurance",
        "contract",
        "renewal",
        "subscription"
      ],
      "default": "payment",
      "title": "Type"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "amount": {
      "type": "number",
      "title": "Amount"
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "none",
        "monthly",
        "quarterly",
        "annual"
      ],
      "default": "none",
      "title": "Recurrence"
    },
    "document_id": {
      "type": "string",
      "title": "Document ID"
    },
    "task_id": {
      "type": "string",
      "title": "Task ID"
    },
    "calendar_event_id": {
      "type": "string",
      "title": "Calendar Event ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "done",
        "overdue"
      ],
      "default": "open",
      "title": "Status"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}