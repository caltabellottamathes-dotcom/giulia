{
  "name": "BriefingItem",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email",
        "calendar",
        "project",
        "task",
        "deadline",
        "important",
        "document",
        "meeting",
        "insight"
      ],
      "title": "Type"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "summary": {
      "type": "string",
      "title": "Summary"
    },
    "source": {
      "type": "string",
      "title": "Source"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Timestamp"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "important",
        "relevant",
        "later"
      ],
      "default": "relevant",
      "title": "Priority"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "later",
        "actioned",
        "dismissed"
      ],
      "default": "new",
      "title": "Status"
    },
    "related_person": {
      "type": "string",
      "title": "Related Person"
    },
    "related_project": {
      "type": "string",
      "title": "Related Project"
    },
    "related_task": {
      "type": "string",
      "title": "Related Task"
    },
    "related_event": {
      "type": "string",
      "title": "Related Event"
    },
    "suggested_action": {
      "type": "string",
      "title": "Suggested Action"
    },
    "action_route": {
      "type": "string",
      "title": "Action Route"
    },
    "action_params": {
      "type": "object",
      "title": "Action Params"
    },
    "context": {
      "type": "string",
      "title": "Context"
    },
    "payload": {
      "type": "object",
      "title": "Payload"
    },
    "away_hours": {
      "type": "number",
      "title": "Away Hours"
    }
  },
  "required": [
    "type",
    "title",
    "summary"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}