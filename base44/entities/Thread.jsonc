{
  "name": "Thread",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "summary": {
      "type": "string",
      "title": "Summary"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "archived"
      ],
      "default": "open",
      "title": "Status"
    },
    "type": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp",
        "task",
        "note",
        "calendar"
      ],
      "title": "Type"
    },
    "person_id": {
      "type": "string",
      "title": "Person ID"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "relevance": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium",
      "title": "Relevance"
    },
    "channel": {
      "type": "string",
      "title": "Channel"
    },
    "needs_info": {
      "type": "boolean",
      "default": false,
      "title": "Needs Info"
    },
    "draft_ready": {
      "type": "boolean",
      "default": false,
      "title": "Draft Ready"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}