{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "start": {
      "type": "string",
      "format": "date-time",
      "title": "Start"
    },
    "end": {
      "type": "string",
      "format": "date-time",
      "title": "End"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Attendees"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "all_day": {
      "type": "boolean",
      "default": false,
      "title": "All Day"
    }
  },
  "required": [
    "title",
    "start"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}