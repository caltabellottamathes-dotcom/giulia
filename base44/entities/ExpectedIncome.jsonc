{
  "name": "ExpectedIncome",
  "type": "object",
  "title": "ExpectedIncome",
  "description": "Verwachte inkomsten buiten de vaste stroom \u2014 offertes, erfenissen, uitkeringen, bonussen. Gebaseerd op voortgang/communicatie weet Giulia welke deels al zeker zijn.",
  "properties": {
    "title": {
      "type": "string",
      "title": "Titel"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "quotation",
        "inheritance",
        "bonus",
        "refund",
        "grant",
        "other"
      ],
      "default": "quotation",
      "title": "Soort"
    },
    "expected_amount": {
      "type": "number",
      "title": "Verwacht bedrag"
    },
    "received_amount": {
      "type": "number",
      "default": 0,
      "title": "Al ontvangen"
    },
    "probability": {
      "type": "number",
      "default": 50,
      "title": "Waarschijnlijkheid (%)"
    },
    "expected_date": {
      "type": "string",
      "format": "date",
      "title": "Verwachte datum"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "contact_id": {
      "type": "string",
      "title": "Contact ID"
    },
    "notes": {
      "type": "string",
      "title": "Notities"
    },
    "status": {
      "type": "string",
      "enum": [
        "expected",
        "partial",
        "received",
        "cancelled"
      ],
      "default": "expected",
      "title": "Status"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "known",
        "estimated",
        "unknown"
      ],
      "default": "estimated",
      "title": "Betrouwbaarheid"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}