{
  "name": "Hobby",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "type": {
      "type": "string",
      "enum": [
        "music",
        "creative",
        "cultural",
        "sport",
        "learning",
        "collecting",
        "other"
      ],
      "default": "creative",
      "title": "Type"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "title": "Status"
    },
    "activity_level": {
      "type": "string",
      "enum": [
        "active",
        "reactivating",
        "quiet",
        "new",
        "emerging",
        "archived"
      ],
      "default": "active",
      "title": "Activity Level"
    },
    "current_thread": {
      "type": "string",
      "title": "Current Thread"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "color": {
      "type": "string",
      "title": "Color"
    },
    "image": {
      "type": "string",
      "format": "uri",
      "title": "Image"
    },
    "frequency": {
      "type": "string",
      "title": "Frequency"
    },
    "linked_project_id": {
      "type": "string",
      "title": "Linked Project ID"
    },
    "related_project_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Related Project IDs"
    },
    "mentions_count": {
      "type": "number",
      "default": 0,
      "title": "Mentions Count"
    },
    "discovered_date": {
      "type": "string",
      "format": "date",
      "title": "Discovered Date"
    },
    "last_activity_date": {
      "type": "string",
      "format": "date-time",
      "title": "Last Activity Date"
    },
    "next_activity": {
      "type": "string",
      "title": "Next Activity"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}