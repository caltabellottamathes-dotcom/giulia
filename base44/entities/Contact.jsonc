{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "company": {
      "type": "string",
      "title": "Company"
    },
    "role": {
      "type": "string",
      "title": "Role"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "avatar": {
      "type": "string",
      "format": "uri",
      "title": "Avatar"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "unconfirmed"
      ],
      "default": "confirmed",
      "title": "Status"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date-time",
      "title": "Last Contact Date"
    },
    "last_notified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Notified At"
    },
    "project_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Project IDs"
    },
    "relationship_type": {
      "type": "string",
      "title": "Relationship Type"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    },
    "desired_frequency_days": {
      "type": "number",
      "title": "Desired Frequency (days)"
    },
    "relationship_domain": {
      "type": "string",
      "enum": [
        "focus",
        "life"
      ],
      "title": "Relationship Domain"
    },
    "last_meaningful_contact_date": {
      "type": "string",
      "format": "date-time",
      "title": "Last Meaningful Contact Date",
      "description": "Laatste betekenisvolle interactie (voor Relationship Rhythm Check) \u2014 apart van ruwe last_contact_date."
    },
    "contact_rhythm_days": {
      "type": "number",
      "title": "Contact Rhythm (days)",
      "description": "Persoonlijke baseline-interval tussen betekenisvolle contacten, afgeleid uit historie."
    },
    "relationship_state": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "CLOSE",
        "QUIET",
        "QUIETER_THAN_USUAL",
        "EMERGING",
        "RECONNECTING",
        "CHANGING",
        "UNKNOWN"
      ],
      "default": "UNKNOWN",
      "title": "Relationship State",
      "description": "Beschrijvend, niet diagnostisch \u2014 berekend door socialEngine."
    },
    "relationship_health": {
      "type": "object",
      "title": "Relationship Health",
      "description": "Samengestelde signalen (g\u00e9\u00e9n score): connection/recency/rhythm/reciprocity/quality/context/intention/change.",
      "properties": {
        "connection": {
          "type": "string"
        },
        "recency": {
          "type": "string"
        },
        "rhythm": {
          "type": "string"
        },
        "reciprocity": {
          "type": "string"
        },
        "quality": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "intention": {
          "type": "string"
        },
        "change": {
          "type": "string"
        },
        "computed_at": {
          "type": "string"
        }
      }
    },
    "relationship_pattern_note": {
      "type": "string",
      "title": "Relationship Pattern Note",
      "description": "Laatst gedetecteerde Pattern/Pattern Shift/Deviation, kort en leesbaar."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}