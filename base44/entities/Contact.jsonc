{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "company": {
      "type": "string",
      "title": "Company"
    },
    "role": {
      "type": "string",
      "title": "Role"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "avatar": {
      "type": "string",
      "format": "uri",
      "title": "Avatar"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date-time",
      "title": "Last Contact Date"
    },
    "project_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Project IDs"
    },
    "relationship_type": {
      "type": "string",
      "title": "Relationship Type"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}