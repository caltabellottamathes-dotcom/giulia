{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "company": {
      "type": "string",
      "title": "Company"
    },
    "role": {
      "type": "string",
      "title": "Role"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "avatar": {
      "type": "string",
      "format": "uri",
      "title": "Avatar"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "unconfirmed"
      ],
      "default": "confirmed",
      "title": "Status"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date-time",
      "title": "Last Contact Date"
    },
    "last_notified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Notified At"
    },
    "project_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Project IDs"
    },
    "relationship_type": {
      "type": "string",
      "title": "Relationship Type"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    },
    "desired_frequency_days": {
      "type": "number",
      "title": "Desired Frequency (days)"
    },
    "relationship_domain": {
      "type": "string",
      "enum": [
        "focus",
        "life"
      ],
      "title": "Relationship Domain"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}