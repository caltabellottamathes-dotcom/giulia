{
  "name": "Document",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "type": {
      "type": "string",
      "enum": [
        "pdf",
        "image",
        "doc",
        "sheet",
        "figma",
        "other"
      ],
      "default": "other",
      "title": "Type"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "reference",
        "contract",
        "invoice",
        "notes",
        "other"
      ],
      "default": "other",
      "title": "Document Type"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "title": "URL"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "recent",
        "project",
        "shared",
        "favorite",
        "giulia"
      ],
      "default": "recent",
      "title": "Status"
    },
    "owner": {
      "type": "string",
      "title": "Owner"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}