{
  "name": "Milestone",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "done",
        "planning",
        "waiting"
      ],
      "default": "open",
      "title": "Status"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "linked_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Linked Tasks"
    },
    "involved_people": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Involved People"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}