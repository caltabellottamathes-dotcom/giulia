{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "planning",
        "in_progress",
        "review",
        "waiting",
        "afwerking",
        "completed",
        "paused",
        "archived"
      ],
      "default": "planning",
      "title": "Status"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "title": "Progress"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "title": "Deadline"
    },
    "image": {
      "type": "string",
      "format": "uri",
      "title": "Image"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "next_milestone": {
      "type": "string",
      "title": "Next Milestone"
    },
    "color": {
      "type": "string",
      "title": "Color"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "last_activity_date": {
      "type": "string",
      "format": "date-time",
      "title": "Last Activity Date"
    },
    "last_notified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Notified At"
    },
    "health": {
      "type": "string",
      "enum": [
        "good",
        "attention",
        "critical"
      ],
      "default": "good",
      "title": "Health"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    },
    "domain": {
      "type": "string",
      "enum": [
        "focus",
        "life",
        "self"
      ],
      "title": "Domain"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}