{
  "name": "Idea",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "exploring",
        "actionable",
        "archived"
      ],
      "default": "new",
      "title": "Status"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "resurfaced_date": {
      "type": "string",
      "format": "date-time",
      "title": "Resurfaced Date"
    },
    "embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "title": "Embedding"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}