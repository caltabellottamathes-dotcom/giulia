{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "status": {
      "type": "string",
      "enum": [
        "today",
        "upcoming",
        "overdue",
        "waiting",
        "delegated",
        "completed"
      ],
      "default": "upcoming",
      "title": "Status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "title": "Priority"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "title": "Deadline"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "contact_id": {
      "type": "string",
      "title": "Contact ID"
    },
    "delegated_to_giulia": {
      "type": "boolean",
      "default": false,
      "title": "Delegated to Giulia"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}