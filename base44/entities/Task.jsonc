{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "waiting",
        "delegated",
        "completed",
        "archived"
      ],
      "default": "todo",
      "title": "Status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "title": "Priority"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "title": "Deadline"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "contact_id": {
      "type": "string",
      "title": "Contact ID"
    },
    "delegated_to_giulia": {
      "type": "boolean",
      "default": false,
      "title": "Delegated to Giulia"
    },
    "parent_task_id": {
      "type": "string",
      "title": "Parent Task ID"
    },
    "subtasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Subtasks"
    },
    "energy_level": {
      "type": "string",
      "enum": [
        "deep",
        "shallow",
        "quick"
      ],
      "title": "Energy Level"
    },
    "estimated_duration": {
      "type": "number",
      "title": "Estimated Duration (min)"
    },
    "context": {
      "type": "string",
      "title": "Context"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}