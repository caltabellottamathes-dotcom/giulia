{
  "name": "Income",
  "type": "object",
  "title": "Income",
  "description": "Inkomstenbron binnen het financi\u00eble systeem. Uitgebreid met verwachte datum, ontvangen bedrag en status.",
  "properties": {
    "amount": {
      "type": "number",
      "title": "Bedrag"
    },
    "currency": {
      "type": "string",
      "default": "EUR",
      "title": "Valuta"
    },
    "category": {
      "type": "string",
      "title": "Categorie"
    },
    "description": {
      "type": "string",
      "title": "Beschrijving / bron"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Datum"
    },
    "recurring": {
      "type": "boolean",
      "default": false,
      "title": "Terugkerend"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly",
        "bimonthly",
        "quarterly",
        "semiannual",
        "annual",
        "once",
        "variable"
      ],
      "default": "monthly",
      "title": "Frequentie"
    },
    "expected_date": {
      "type": "string",
      "format": "date",
      "title": "Verwachte datum"
    },
    "received_amount": {
      "type": "number",
      "title": "Daadwerkelijk ontvangen bedrag"
    },
    "status": {
      "type": "string",
      "enum": [
        "expected",
        "received",
        "missed",
        "partial"
      ],
      "default": "expected",
      "title": "Status"
    },
    "account_source": {
      "type": "string",
      "title": "Account Source"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "contact_id": {
      "type": "string",
      "title": "Contact ID"
    },
    "source_id": {
      "type": "string",
      "title": "Ingestion Source ID"
    }
  },
  "required": [
    "amount"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}