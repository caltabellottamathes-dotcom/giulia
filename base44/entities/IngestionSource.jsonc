{
  "name": "IngestionSource",
  "type": "object",
  "properties": {
    "source_type": {
      "type": "string",
      "enum": [
        "pdf",
        "text",
        "image",
        "structured"
      ],
      "default": "text",
      "title": "Source Type"
    },
    "original_filename": {
      "type": "string",
      "title": "Original Filename"
    },
    "file_url": {
      "type": "string",
      "format": "uri",
      "title": "File URL"
    },
    "pasted_text": {
      "type": "string",
      "title": "Pasted Text"
    },
    "extracted_text": {
      "type": "string",
      "title": "Extracted Text"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "reading",
        "understanding",
        "structuring",
        "classifying",
        "matching",
        "reconciling",
        "validating",
        "extracting",
        "connecting",
        "updating",
        "distributing",
        "pending_approval",
        "complete",
        "partial",
        "failed"
      ],
      "default": "received",
      "title": "Status"
    },
    "confidence": {
      "type": "string",
      "title": "Confidence"
    },
    "overall_subject": {
      "type": "string",
      "title": "Overall Subject"
    },
    "purpose": {
      "type": "string",
      "title": "Purpose"
    },
    "detected_project_id": {
      "type": "string",
      "title": "Detected Project ID",
      "description": "Het project waar deze bron bij hoort (verrijking boven nieuwe aanmaak). Leeg bij globale/LIFE/Knowledge-bronnen."
    },
    "detected_project_match_reason": {
      "type": "string",
      "title": "Detected Project Match Reason",
      "description": "Waarom GIULIA denkt dat deze bron bij het detected_project hoort."
    },
    "project_understanding": {
      "type": "object",
      "title": "Project Understanding Model",
      "description": "Tijdelijke semantische representatie v\u00f3\u00f3r uitvoering: themes-boom + geclassificeerde items.",
      "properties": {
        "context_domain": {
          "type": "string",
          "enum": [
            "focus",
            "life",
            "knowledge",
            "memory",
            "global"
          ]
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "parent_title": {
                "type": "string"
              },
              "order": {
                "type": "number"
              }
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "number"
              },
              "classification": {
                "type": "string"
              },
              "theme_title": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": true
              },
              "confidence": {
                "type": "string"
              },
              "explicit": {
                "type": "boolean"
              },
              "source_span": {
                "type": "string"
              },
              "reasoning": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "detected_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "number"
          },
          "class": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "explicit": {
            "type": "boolean"
          }
        }
      },
      "title": "Detected Entities"
    },
    "proposed_records": {
      "type": "array",
      "title": "Proposed Records",
      "description": "GIULIA's voorgestelde entiteiten \u2014 pas aan of sla over v\u00f3\u00f3r goedkeuring. Niets wordt aangemaakt tot de gebruiker goedkeurt.",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "number"
          },
          "entity_class": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": true
          },
          "confidence": {
            "type": "string"
          },
          "explicit": {
            "type": "boolean"
          },
          "source_span": {
            "type": "string"
          },
          "inferred_notes": {
            "type": "string"
          },
          "reasoning": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "existing_id": {
            "type": "string"
          },
          "existing_title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "plan_action": {
            "type": "string",
            "enum": [
              "CREATE",
              "UPDATE",
              "LINK",
              "MERGE",
              "KEEP",
              "IGNORE",
              "ASK"
            ]
          },
          "theme_title": {
            "type": "string"
          },
          "validation": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "change_plan": {
      "type": "array",
      "title": "Change Plan",
      "description": "Het gevalideerde plan: per wijziging entity/record/field/old/new/reason/source/confidence.",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "number"
          },
          "entity_class": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "CREATE",
              "UPDATE",
              "LINK",
              "MERGE",
              "KEEP",
              "IGNORE",
              "ASK"
            ]
          },
          "title": {
            "type": "string"
          },
          "existing_id": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": true
          },
          "field_changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "old_value": {
                  "type": "string"
                },
                "new_value": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "source_span": {
            "type": "string"
          },
          "validation_ok": {
            "type": "boolean"
          },
          "validation_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "generated_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "title": "Generated Records"
    },
    "updated_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "title": "Updated Records"
    },
    "relationships_created": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      },
      "title": "Relationships Created"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "title": "Conflicts"
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "number"
          },
          "class": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "title": "Unresolved"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "target_ref": {
            "type": "string"
          }
        }
      },
      "title": "Gaps"
    },
    "project_health": {
      "type": "object",
      "title": "Project Health (post-execution)",
      "description": "Reconstructie-uitkomst na uitvoering: structuur, volledigheid, volgende stappen.",
      "properties": {
        "completeness": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "health": {
          "type": "string"
        },
        "computed_at": {
          "type": "string"
        }
      }
    },
    "processing_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "title": "Processing History"
    },
    "version": {
      "type": "number",
      "default": 1,
      "title": "Version"
    },
    "error": {
      "type": "string",
      "title": "Error"
    }
  },
  "required": [
    "source_type"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}