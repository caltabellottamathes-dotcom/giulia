{
  "name": "Note",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "tags": {
      "type": "string",
      "title": "Tags"
    },
    "kind": {
      "type": "string",
      "enum": [
        "note",
        "idea",
        "commitment",
        "thinking"
      ],
      "default": "note",
      "title": "Kind"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "person_id": {
      "type": "string",
      "title": "Person ID"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    },
    "theme_id": {
      "type": "string",
      "title": "Theme ID",
      "description": "Gekoppeld ProjectTheme-onderdeel (naast project_id)."
    },
    "source_id": {
      "type": "string",
      "title": "Ingestion Source ID",
      "description": "Provenance: uit welke IngestionSource is deze notitie ontstaan."
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}