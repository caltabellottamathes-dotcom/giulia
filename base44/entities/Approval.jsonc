{
  "name": "Approval",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "action_type": {
      "type": "string",
      "title": "Action Type"
    },
    "target": {
      "type": "string",
      "title": "Target"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "proposed_action": {
      "type": "string",
      "title": "Proposed Action"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "executed",
        "discarded",
        "edited",
        "already_done",
        "expired"
      ],
      "default": "pending",
      "title": "Status"
    },
    "category": {
      "type": "string",
      "enum": [
        "urgent",
        "communication",
        "projects",
        "intern",
        "proactive"
      ],
      "default": "communication",
      "title": "Category"
    },
    "type": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp",
        "calendar",
        "task",
        "file"
      ],
      "title": "Type"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "context": {
      "type": "string",
      "title": "Context"
    },
    "thread_id": {
      "type": "string",
      "title": "Thread ID"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    },
    "assignee": {
      "type": "string",
      "enum": [
        "salvo",
        "giulia"
      ],
      "default": "salvo",
      "title": "Assignee"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "title": "Reminder Sent"
    }
  },
  "required": [
    "action_type",
    "description"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}