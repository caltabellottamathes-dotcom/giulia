{
  "name": "Memory",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "User preferences",
        "People",
        "Projects",
        "Routines",
        "Important information",
        "Conversation-derived",
        "Insights"
      ],
      "default": "User preferences",
      "title": "Category"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "confidence": {
      "type": "number",
      "default": 0.5,
      "title": "Confidence"
    },
    "source": {
      "type": "string",
      "title": "Source"
    },
    "embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "title": "Embedding"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}