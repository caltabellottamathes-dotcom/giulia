{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "title": "Task ID"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "task_title": {
      "type": "string",
      "title": "Task Title"
    },
    "project_title": {
      "type": "string",
      "title": "Project Title"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "title": "End Time"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Duration (min)"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "stopped"
      ],
      "default": "stopped",
      "title": "Status"
    },
    "note": {
      "type": "string",
      "title": "Note"
    }
  },
  "required": [
    "start_time"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}