{
  "name": "Upload",
  "type": "object",
  "properties": {
    "file_url": {
      "type": "string",
      "format": "uri",
      "title": "File URL"
    },
    "filename": {
      "type": "string",
      "title": "Filename"
    },
    "note": {
      "type": "string",
      "title": "Note"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "processed",
        "archived"
      ],
      "default": "new",
      "title": "Status"
    },
    "uploaded_for": {
      "type": "string",
      "title": "Uploaded For"
    },
    "folder": {
      "type": "string",
      "title": "Map",
      "description": "Naam van de map binnen de mediatheek."
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "categorized": {
      "type": "boolean",
      "default": false,
      "title": "Categorized"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "contract",
        "invoice",
        "image",
        "notes",
        "reference",
        "other"
      ],
      "default": "other",
      "title": "Document Type"
    },
    "version_number": {
      "type": "number",
      "default": 1,
      "title": "Version Number"
    },
    "version_of": {
      "type": "string",
      "title": "Version Of (Upload ID)"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    }
  },
  "required": [
    "file_url"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}