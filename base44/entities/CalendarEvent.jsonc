{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "start": {
      "type": "string",
      "format": "date-time",
      "title": "Start"
    },
    "end": {
      "type": "string",
      "format": "date-time",
      "title": "End"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "tentative",
        "cancelled"
      ],
      "default": "tentative",
      "title": "Status"
    },
    "participants": {
      "type": "string",
      "title": "Participants"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "travel_time": {
      "type": "number",
      "title": "Travel Time (min)"
    },
    "prep_time": {
      "type": "number",
      "title": "Prep Time (min)"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}