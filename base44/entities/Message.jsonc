{
  "name": "Message",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "giulia",
        "mattia",
        "incoming"
      ],
      "title": "Role"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "thread_id": {
      "type": "string",
      "title": "Thread ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "draft",
        "pending",
        "archived"
      ],
      "default": "draft",
      "title": "Status"
    },
    "channel": {
      "type": "string",
      "enum": [
        "in-app",
        "whatsapp",
        "email",
        "voice"
      ],
      "title": "Channel"
    },
    "direction": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing"
      ],
      "title": "Direction"
    },
    "is_draft": {
      "type": "boolean",
      "default": false,
      "title": "Is Draft"
    },
    "gmail_message_id": {
      "type": "string",
      "title": "Gmail Message ID"
    },
    "gmail_thread_id": {
      "type": "string",
      "title": "Gmail Thread ID"
    },
    "whatsapp_message_id": {
      "type": "string",
      "title": "WhatsApp Message ID"
    },
    "agent_source": {
      "type": "string",
      "title": "Agent Source"
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Tool Calls"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "title": "Attachments"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}