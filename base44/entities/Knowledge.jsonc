{
  "name": "Knowledge",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "category": {
      "type": "string",
      "enum": [
        "Research",
        "Notes",
        "Insights",
        "References",
        "Decisions",
        "Conversations",
        "Saved"
      ],
      "default": "Notes",
      "title": "Category"
    },
    "source": {
      "type": "string",
      "title": "Source"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "media_url": {
      "type": "string",
      "format": "uri",
      "title": "Media URL"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "doc"
      ],
      "title": "Media Type"
    },
    "theme_id": {
      "type": "string",
      "title": "Theme ID",
      "description": "Gekoppeld ProjectTheme-onderdeel (naast project_id)."
    },
    "source_id": {
      "type": "string",
      "title": "Ingestion Source ID",
      "description": "Provenance: uit welke IngestionSource is deze kennis ontstaan."
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}