    },
    {
      "function_name": "runSelfCheckIns",
      "description": "SELF proactieve check-in runner \u2014 initieert context-bewuste check-ins (~3x/dag) via Gemini."
    },
    {
      "function_name": "analyzeSelfPatterns",
      "description": "SELF patroon-analyse \u2014 scant check-ins/routines/tijd en formuleert SelfInsight-patronen."
    },
    {
      "function_name": "buildDailyJournal",
